<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_program_banner"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#66000000"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:elevation="12dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/player_program_logo"
        android:layout_width="74dp"
        android:layout_height="64dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="18dp">

        <TextView
            android:id="@+id/player_program_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CH --  Channel"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_program_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Program"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/player_program_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="#BDBDBD"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/player_epg_button"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_epg"
        android:contentDescription="EPG"
        android:tint="#FF0000"
        android:focusable="true"
        android:clickable="true"
        android:padding="12dp" />

    <ImageButton
        android:id="@+id/player_favorite_button"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_favorite_outline"
        android:contentDescription="Favorite"
        android:focusable="true"
        android:clickable="true"
        android:padding="12dp" />
</LinearLayout>
