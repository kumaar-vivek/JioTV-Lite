<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090909">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:resize_mode="fit"
        android:focusable="false" />

    <TextView
        android:id="@+id/tv_error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#AA000000"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp"
        android:text="Failed to load channels"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/channel_grid_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#101010"
        android:padding="28dp"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:id="@+id/channels_title_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/title_channels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Channels"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_epg"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_epg"
                    android:tint="#FF0000"
                    android:contentDescription="EPG"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="11dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#303030"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <android.widget.EditText
                    android:id="@+id/et_search"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:hint="Search name/number..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"/>

                <android.widget.ImageButton
                    android:id="@+id/btn_clear_search"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_clear"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear search"
                    android:padding="8dp"
                    android:visibility="gone" />

                <android.widget.ImageButton
                    android:id="@+id/btn_voice_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voice Search" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tv_current_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08 Aug 2026"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_current_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <android.widget.ImageButton
                    android:id="@+id/btn_logout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_logout"
                    android:tint="#FF0000"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Logout"
                    android:padding="8dp" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/filter_language"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/filter_focus_selector"
                android:padding="12dp"
                android:text="Languages: Hindi, English, Bhojpuri"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/filter_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/filter_focus_selector"
                android:padding="12dp"
                android:text="Categories: Ent, Movies, News..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <android.widget.GridView
            android:id="@+id/channel_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="5"
            android:horizontalSpacing="14dp"
            android:verticalSpacing="14dp"
            android:stretchMode="columnWidth"
            android:listSelector="@drawable/channel_tile_selector"
            android:drawSelectorOnTop="false"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_container"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="#202020"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JioTV Login"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <android.widget.EditText
            android:id="@+id/et_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mobile_hint"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"/>

        <android.widget.Button
            android:id="@+id/btn_send_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/send_otp"
            android:layout_marginTop="12dp"/>

        <android.widget.EditText
            android:id="@+id/et_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/otp_hint"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:visibility="gone"/>

        <android.widget.Button
            android:id="@+id/btn_verify_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/verify_otp"
            android:visibility="gone"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/channel_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_margin="32dp"
        android:background="#AA000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_channel_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CH --"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tv_channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#DDDDDD"
            android:textSize="16sp"/>
    </LinearLayout>


    <include
        layout="@layout/player_program_banner"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_gravity="bottom" />

    <include
        layout="@layout/epg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
